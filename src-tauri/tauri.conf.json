{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AcompanION",
  "version": "0.1.0",
  "identifier": "io.github.swellshinider.acompanion",
  "build": {
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/acompanion/browser",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{ "title": "AcompanION", "width": 1100, "height": 700, "minWidth": 480, "minHeight": 400 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
